{
  "manifest_version": 3,
  "name": "Swayam - Bulk AI Prompt Runner",
  "version": "0.1.0",
  "description": "Runs prompts from a local CSV/TXT file sequentially on ChatGPT, Gemini and Claude web UIs, captures responses and exports results. 100% local - no servers, no telemetry.",
  "author": "Swayam",

  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "downloads",
    "scripting",
    "alarms"
  ],

  "background": {
    "service_worker": "background/background.js"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Swayam - Bulk AI Prompt Runner",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*"
      ],
      "js": ["content-scripts/content-script.js"],
      "run_at": "document_idle"
    }
  ],

  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*"
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "minimum_chrome_version": "109"
}
